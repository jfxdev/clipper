# Copy to .env and adjust. Used by `docker compose` and `make dev`.
# See backend/internal/config/config.go for full parsing/validation rules.

# --- Server ---
PORT=8080

# --- Store backend: memory | redis | mongo | dynamo ---
# memory loses data on restart and doesn't share across replicas; fine for
# local dev, not for anything else.
STORE_BACKEND=redis

# --- Redis (used when STORE_BACKEND=redis) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=devpassword
REDIS_DB=0
REDIS_TLS=false

# --- MongoDB (used when STORE_BACKEND=mongo) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=clipper
MONGO_COLLECTION=pastes

# --- DynamoDB (used when STORE_BACKEND=dynamo) ---
DYNAMO_TABLE=clipper_pastes
DYNAMO_ENDPOINT=
DYNAMO_REGION=us-east-1

# --- Rate limiting ---
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
GLOBAL_RATE_LIMIT_RPS=200
GLOBAL_RATE_LIMIT_BURST=400
RATE_LIMIT_MAX_CLIENTS=100000

# --- Quotas ---
QUOTA_PASTES_PER_DAY=200
QUOTA_BYTES_PER_DAY=67108864

# --- Paste limits ---
MAX_PASTE_SIZE_BYTES=2097152
MAX_EXPIRE_SECONDS=2592000

# --- Reverse proxy trust ---
# Set to your proxy's CIDR(s), comma-separated, e.g. 10.0.0.0/8. Leave
# empty for local dev (X-Forwarded-For is then ignored).
TRUSTED_PROXIES=
TRUST_PROXY=false

# --- TLS termination ---
# Set once a TLS terminator sits in front of the process.
HSTS_MAX_AGE_SECONDS=0
